# PostgreSQL connection used by the FastAPI application
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/songs
# Ask AI provider: ollama (local, default) or groq (hosted)
AI_PROVIDER=ollama
# Local Ollama settings
AI_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
AI_NUM_CTX=8192
AI_NUM_PREDICT=512
# Groq settings, only needed when AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
